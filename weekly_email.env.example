# Copy to weekly_email.env and fill values.
# Keep this file private: chmod 600 weekly_email.env

# Gmail SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Email metadata
ALERT_EMAIL_FROM=yourname@gmail.com
ALERT_EMAIL_TO=yourname@gmail.com,teammate@example.com
EMAIL_SUBJECT_PREFIX=AutomationDetection weekly flare alert

# Detection settings
FLARE_THRESHOLD_MULTIPLIER=2.0
CONSECUTIVE_POINTS=3
INCREMENTAL_PERCENT=0.3
# Cadence to pull from the light-curve DB: 3day, weekly, monthly
LIGHTCURVE_CADENCE=weekly
# Analyze only this trailing time window (in weeks)
LOOKBACK_WEEKS=20.0
# Detection method: original, sigma, or both
DETECTION_METHOD=sigma
# Confirmed flare start threshold in sigma units above quiescent background
CONFIRMED_SIGMA_THRESHOLD=3.0

# Optional multiplier sweep for original detection method only.
# Ignored when DETECTION_METHOD=sigma.
# FLARE_THRESHOLD_MULTIPLIERS=1,2,3

# MDP99 settings for flare detections
# COSI background rate in counts/s (20, 10, 1 are mapped with the notebook's 0.25 factor -> 5, 2.5, 0.25)
COSI_BACKGROUND_RATE=5.0
# Optional override for source-count reduction factor (default is inferred from COSI_BACKGROUND_RATE)
# ARM_REDUCTION=1.0
# Average modulation factor mu used in MDP99
MDP99_AVERAGE_MU=0.3

# Optional: set to a single source; leave blank to scan all NameCSV sources
SOURCE_NAME=

# Optional: set to 1 to force email send even if already sent this ISO week
EMAIL_FORCE_SEND=0
